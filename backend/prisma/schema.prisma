generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum MovementStatus {
  PENDIENTE
  COMPLETADO
  RECHAZADO
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  custodianId Int?       @unique
  custodian   Custodian? @relation(fields: [custodianId], references: [id], onDelete: SetNull)

  assetsCreated          Asset[]
  movimientosRegistrados AssetMovement[] @relation("MovimientosRegistrados")
  movimientosConfirmados AssetMovement[] @relation("MovimientosConfirmados")

  @@index([role])
  @@index([isActive])
}

model Location {
  id        Int      @id @default(autoincrement())
  canton    String?
  parroquia String?
  lat       Float?
  lng       Float?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets     Asset[]
  custodians Custodian[]

  movimientosComoOrigen  AssetMovement[] @relation("MovimientosDesdeUbicacion")
  movimientosComoDestino AssetMovement[] @relation("MovimientosHaciaUbicacion")

  @@index([canton, parroquia])
  @@index([isDeleted])
}

model Custodian {
  id         Int      @id @default(autoincrement())
  fullName   String
  identifier String   @unique
  unit       String?
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  locationId Int?
  geoLocation Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  assets Asset[]

  movimientosComoOrigen  AssetMovement[] @relation("MovimientosDesde")
  movimientosComoDestino AssetMovement[] @relation("MovimientosHacia")

  userAccount User?

  @@index([fullName])
  @@index([isDeleted])
}

model Asset {
  id               Int       @id @default(autoincrement())
  code             String?   @unique
  previousCode     String?
  assetName        String
  brand            String?
  model            String?
  serialNumber     String?
  location         String?
  physicalLocation String?
  entryDate        DateTime?
  activationDate   DateTime?
  accountCode      String?
  initialValue     Decimal?  @db.Decimal(12, 2)
  currentValue     Decimal?  @db.Decimal(12, 2)
  note             String?
  isDeleted        Boolean   @default(false)

  custodianId      Int?
  custodian        Custodian? @relation(fields: [custodianId], references: [id], onDelete: SetNull)

  createdByUserId  Int?
  createdByUser    User?       @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  locationId       Int?
  geoLocation      Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  movements        AssetMovement[]

  @@index([custodianId])
  @@index([createdByUserId])
  @@index([locationId])
  @@index([assetName])
  @@index([code])
  @@index([isDeleted])
}

model AssetMovement {
  id           Int            @id @default(autoincrement())
  groupId      String?
  transferDate DateTime       @default(now())
  note         String?
  actaUrl      String?
  status       MovementStatus @default(PENDIENTE)
  confirmedAt  DateTime?
  createdAt    DateTime       @default(now())

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  fromCustodianId Int?
  fromCustodian   Custodian? @relation("MovimientosDesde", fields: [fromCustodianId], references: [id], onDelete: SetNull)

  toCustodianId Int?
  toCustodian   Custodian? @relation("MovimientosHacia", fields: [toCustodianId], references: [id], onDelete: SetNull)

  fromLocationId Int?
  fromLocation   Location? @relation("MovimientosDesdeUbicacion", fields: [fromLocationId], references: [id], onDelete: SetNull)

  toLocationId Int?
  toLocation   Location? @relation("MovimientosHaciaUbicacion", fields: [toLocationId], references: [id], onDelete: SetNull)

  registeredByUserId Int?
  registeredBy       User? @relation("MovimientosRegistrados", fields: [registeredByUserId], references: [id], onDelete: SetNull)

  confirmedByUserId Int?
  confirmedBy       User? @relation("MovimientosConfirmados", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([fromCustodianId])
  @@index([toCustodianId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([registeredByUserId])
  @@index([confirmedByUserId])
  @@index([status])
  @@index([groupId])
  @@index([groupId, status])
  @@index([createdAt])
}

model BrandSettings {
  id             Int      @id @default(autoincrement())
  appName        String   @default("Parque Informático")
  primaryColor   String   @default("#4f46e5")
  secondaryColor String   @default("#6366f1")
  accentColor    String   @default("#e0e7ff")
  logoUrl        String?
  faviconUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
