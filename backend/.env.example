DATABASE_URL="postgresql://informaticpark:informaticpark_dev@localhost:5432/informaticpark"
# Optional: use Supabase Session Pooler (port 5432) for Prisma migrations.
DIRECT_URL="postgresql://postgres.project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres"
# Maximum number of locations to export without pagination
LOCATIONS_MAX_EXPORT=500
JWT_SECRET="replace-with-a-local-development-secret"
JWT_EXPIRES_IN="1h"
PORT=4000
CORS_ORIGINS="http://localhost:3000"

# Supabase Storage
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="actas"
SUPABASE_SIGNED_URL_EXPIRES_IN=3600
